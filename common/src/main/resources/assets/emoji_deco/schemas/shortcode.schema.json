{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "emoji_deco Shortcode",
  "description": "Defines a :shortcode: or :shortcode.arg1,arg2: glyph/text",
  "type": "object",
  "properties": {
    "enable": {
      "type": "boolean",
      "description": "Whether this shortcode is active",
      "default": true
    },
    "args": {
      "type": "array",
      "description": "Positional argument definitions (used with :shortcode.arg1,arg2:)",
      "items": { "$ref": "defs.schema.json#/$defs/ArgSpec" }
    },
    "preview": {
      "$ref": "defs.schema.json#/$defs/RichNode",
      "description": "Preview rendered in the autocomplete dropdown; defaults to display if omitted"
    },
    "display": {
      "$ref": "defs.schema.json#/$defs/RichNode",
      "description": "What is rendered when this shortcode is used"
    }
  },
  "required": ["enable", "display"]
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "emoji_deco Decorator",
  "description": "Defines a #decorator[...] or #decorator.arg1[...] text transformation",
  "type": "object",
  "properties": {
    "enable": {
      "type": "boolean",
      "description": "Whether this decorator is active",
      "default": true
    },
    "args": {
      "type": "array",
      "description": "Positional argument definitions (used with #decorator.arg1,arg2[...])",
      "items": { "$ref": "defs.schema.json#/$defs/ArgSpec" }
    },
    "preview": {
      "$ref": "defs.schema.json#/$defs/RichNode",
      "description": "Preview rendered in the autocomplete dropdown"
    },
    "display": {
      "$ref": "defs.schema.json#/$defs/RichNode",
      "description": "How the decorated content is transformed. Must include emoji_deco:slot where the wrapped content should appear."
    }
  },
  "required": ["enable", "display"]
}

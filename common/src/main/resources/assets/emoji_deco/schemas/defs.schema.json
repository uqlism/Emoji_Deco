{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "emoji_deco Shared Definitions",
  "$defs": {

    "ArgNode": {
      "type": "object",
      "description": "Extracts a positional argument by index",
      "properties": {
        "type":    { "const": "emoji_deco:arg" },
        "index":   { "type": "integer", "default": 0, "description": "0-based argument index" },
        "default": { "description": "Fallback value when the argument is missing or empty" }
      },
      "required": ["type"]
    },

    "TimeNode": {
      "type": "object",
      "description": "Returns a time value (game ticks, day ticks, or day count), scaled and offset",
      "properties": {
        "type":   { "const": "emoji_deco:time" },
        "time":   { "type": "string", "enum": ["gametime", "daytime", "day"], "default": "gametime" },
        "scale":  { "$ref": "#/$defs/FloatExpr", "default": 1.0 },
        "offset": { "$ref": "#/$defs/FloatExpr", "default": 0.0 }
      },
      "required": ["type"]
    },

    "MathModNode":   {
      "type": "object",
      "properties": {
        "type":  { "const": "emoji_deco:math/mod" },
        "value": { "$ref": "#/$defs/FloatExpr" },
        "mod":   { "$ref": "#/$defs/FloatExpr", "default": 1.0 }
      },
      "required": ["type"]
    },
    "MathAddNode":   {
      "type": "object",
      "properties": {
        "type": { "const": "emoji_deco:math/add" },
        "a":    { "$ref": "#/$defs/FloatExpr", "default": 0.0 },
        "b":    { "$ref": "#/$defs/FloatExpr", "default": 0.0 }
      },
      "required": ["type"]
    },
    "MathSubNode":   {
      "type": "object",
      "properties": {
        "type": { "const": "emoji_deco:math/sub" },
        "a":    { "$ref": "#/$defs/FloatExpr", "default": 0.0 },
        "b":    { "$ref": "#/$defs/FloatExpr", "default": 0.0 }
      },
      "required": ["type"]
    },
    "MathMulNode":   {
      "type": "object",
      "properties": {
        "type": { "const": "emoji_deco:math/mul" },
        "a":    { "$ref": "#/$defs/FloatExpr", "default": 1.0 },
        "b":    { "$ref": "#/$defs/FloatExpr", "default": 1.0 }
      },
      "required": ["type"]
    },
    "MathAbsNode":   {
      "type": "object",
      "properties": {
        "type":  { "const": "emoji_deco:math/abs" },
        "value": { "$ref": "#/$defs/FloatExpr" }
      },
      "required": ["type"]
    },
    "MathClampNode": {
      "type": "object",
      "properties": {
        "type":  { "const": "emoji_deco:math/clamp" },
        "value": { "$ref": "#/$defs/FloatExpr" },
        "min":   { "$ref": "#/$defs/FloatExpr", "default": 0.0 },
        "max":   { "$ref": "#/$defs/FloatExpr", "default": 1.0 }
      },
      "required": ["type"]
    },
    "MathSinNode":   {
      "type": "object",
      "properties": {
        "type":  { "const": "emoji_deco:math/sin" },
        "value": { "$ref": "#/$defs/FloatExpr", "description": "Input in radians" }
      },
      "required": ["type"]
    },
    "MathCosNode":   {
      "type": "object",
      "properties": {
        "type":  { "const": "emoji_deco:math/cos" },
        "value": { "$ref": "#/$defs/FloatExpr", "description": "Input in radians" }
      },
      "required": ["type"]
    },

    "ColorHsvNode": {
      "type": "object",
      "description": "Converts HSV to a hex color string (#RRGGBB)",
      "properties": {
        "type": { "const": "emoji_deco:color/hsv" },
        "h":    { "$ref": "#/$defs/FloatExpr", "default": 0.0, "description": "Hue (0.0–1.0)" },
        "s":    { "$ref": "#/$defs/FloatExpr", "default": 1.0, "description": "Saturation (0.0–1.0)" },
        "v":    { "$ref": "#/$defs/FloatExpr", "default": 1.0, "description": "Brightness (0.0–1.0)" }
      },
      "required": ["type"]
    },

    "JoinNode": {
      "type": "object",
      "description": "Concatenates an array of strings with an optional separator",
      "properties": {
        "type":      { "const": "emoji_deco:join" },
        "separator": { "type": "string", "default": "" },
        "parts":     { "type": "array", "items": { "$ref": "#/$defs/StringExpr" } }
      },
      "required": ["type", "parts"]
    },

    "PlayerNamesNode": {
      "type": "object",
      "description": "Dynamic list of online player names",
      "properties": {
        "type": { "const": "emoji_deco:player_names" }
      },
      "required": ["type"]
    },

    "FloatExpr": {
      "description": "A number literal or an expression that evaluates to a float",
      "anyOf": [
        { "type": "number" },
        { "$ref": "#/$defs/ArgNode" },
        { "$ref": "#/$defs/TimeNode" },
        { "$ref": "#/$defs/MathModNode" },
        { "$ref": "#/$defs/MathAddNode" },
        { "$ref": "#/$defs/MathSubNode" },
        { "$ref": "#/$defs/MathMulNode" },
        { "$ref": "#/$defs/MathAbsNode" },
        { "$ref": "#/$defs/MathClampNode" },
        { "$ref": "#/$defs/MathSinNode" },
        { "$ref": "#/$defs/MathCosNode" }
      ]
    },

    "StringExpr": {
      "description": "A string literal or an expression that evaluates to a string",
      "anyOf": [
        { "type": "string" },
        { "$ref": "#/$defs/ArgNode" },
        { "$ref": "#/$defs/JoinNode" },
        { "$ref": "#/$defs/PlayerNamesNode" },
        { "$ref": "#/$defs/ColorHsvNode" }
      ]
    },

    "BoolExpr": {
      "description": "A boolean literal or an argument reference",
      "anyOf": [
        { "type": "boolean" },
        { "$ref": "#/$defs/ArgNode" }
      ]
    },

    "FetchUrlSource": {
      "type": "object",
      "description": "Fetches binary data from an HTTP(S) URL",
      "properties": {
        "type":       { "const": "emoji_deco:fetch_url" },
        "url":        { "type": "string", "description": "HTTP(S) URL" },
        "disk_cache": { "type": "boolean", "default": false, "description": "Cache to disk across sessions" },
        "ttl":        { "type": "number",  "default": 0,     "description": "Cache TTL in seconds (0 = no expiry)" }
      },
      "required": ["type", "url"]
    },

    "FetchResourceSource": {
      "type": "object",
      "description": "Loads binary data from the resource pack",
      "properties": {
        "type": { "const": "emoji_deco:fetch_resource" },
        "path": { "type": "string", "description": "Resource location, e.g. 'namespace:textures/foo.png'" }
      },
      "required": ["type", "path"]
    },

    "BinarySource": {
      "anyOf": [
        { "$ref": "#/$defs/FetchUrlSource" },
        { "$ref": "#/$defs/FetchResourceSource" }
      ]
    },

    "FetchAtlasSpec": {
      "type": "object",
      "description": "Fetches a named sprite from a Minecraft texture atlas",
      "properties": {
        "type":   { "const": "emoji_deco:fetch_atlas" },
        "atlas":  {
          "$ref": "#/$defs/StringExpr",
          "description": "Atlas resource location, e.g. 'minecraft:textures/atlas/blocks.png'",
          "examples": [
            "minecraft:textures/atlas/blocks.png",
            "minecraft:textures/atlas/particles.png",
            "minecraft:textures/atlas/paintings.png"
          ]
        },
        "sprite": { "$ref": "#/$defs/StringExpr", "description": "Sprite name within the atlas, e.g. 'item/diamond'" }
      },
      "required": ["type", "atlas", "sprite"]
    },

    "FetchSkinSpec": {
      "type": "object",
      "description": "Fetches a pixel region from a player's skin texture",
      "properties": {
        "type":   { "const": "emoji_deco:fetch_skin" },
        "player": { "$ref": "#/$defs/StringExpr", "description": "Player username" },
        "uv": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4,
          "description": "[x1, y1, x2, y2] pixel region on the 64×64 skin texture. Face: [8,8,16,16], Hat: [40,8,48,16]"
        }
      },
      "required": ["type", "player"]
    },

    "DecodeImageSpec": {
      "type": "object",
      "description": "Decodes an image from a binary source (PNG, GIF, WebP, APNG)",
      "properties": {
        "type":   { "const": "emoji_deco:decode_image" },
        "format": { "type": "string", "enum": ["png", "gif", "webp", "apng"], "description": "Omit to auto-detect" },
        "source": { "$ref": "#/$defs/BinarySource" }
      },
      "required": ["type", "source"]
    },

    "ImageSpec": {
      "anyOf": [
        { "$ref": "#/$defs/FetchAtlasSpec" },
        { "$ref": "#/$defs/FetchSkinSpec" },
        { "$ref": "#/$defs/DecodeImageSpec" }
      ]
    },

    "SlotNode": {
      "type": "object",
      "description": "Placeholder for the decorated content (valid only inside a decorator's display)",
      "properties": {
        "type": { "const": "emoji_deco:slot" }
      },
      "required": ["type"]
    },

    "GlowNode": {
      "type": "object",
      "description": "Applies full-brightness glow or ambient lighting to contents",
      "properties": {
        "type":     { "const": "emoji_deco:glow" },
        "glow":     { "$ref": "#/$defs/BoolExpr", "default": true, "description": "true = max brightness, false = inherit world light" },
        "contents": { "$ref": "#/$defs/RichNode" }
      },
      "required": ["type", "contents"]
    },

    "ScaleNode": {
      "type": "object",
      "description": "Scales the contents by independent x/y factors",
      "properties": {
        "type":     { "const": "emoji_deco:scale" },
        "x":        { "$ref": "#/$defs/FloatExpr", "default": 1.0 },
        "y":        { "$ref": "#/$defs/FloatExpr", "default": 1.0 },
        "contents": { "$ref": "#/$defs/RichNode" }
      },
      "required": ["type", "contents"]
    },

    "OffsetNode": {
      "type": "object",
      "description": "Translates the contents by x/y/z offsets in pixels",
      "properties": {
        "type":     { "const": "emoji_deco:offset" },
        "x":        { "$ref": "#/$defs/FloatExpr", "default": 0.0 },
        "y":        { "$ref": "#/$defs/FloatExpr", "default": 0.0 },
        "z":        { "$ref": "#/$defs/FloatExpr", "default": 0.0, "description": "Depth offset for overlay ordering (e.g. 0.01 draws on top)" },
        "contents": { "$ref": "#/$defs/RichNode" }
      },
      "required": ["type", "contents"]
    },

    "RotateNode": {
      "type": "object",
      "description": "Rotates the contents around its local origin",
      "properties": {
        "type":     { "const": "emoji_deco:rotate" },
        "angle":    { "$ref": "#/$defs/FloatExpr", "default": 0.0, "description": "Angle in radians" },
        "contents": { "$ref": "#/$defs/RichNode" }
      },
      "required": ["type", "contents"]
    },

    "ImageToGlyphNode": {
      "type": "object",
      "description": "Renders an image as an inline glyph",
      "properties": {
        "type":    { "const": "emoji_deco:image_to_glyph" },
        "width":   { "$ref": "#/$defs/FloatExpr", "default": 8, "description": "Display width in pixels" },
        "height":  { "$ref": "#/$defs/FloatExpr", "default": 8, "description": "Display height in pixels" },
        "advance": { "$ref": "#/$defs/FloatExpr", "description": "Cursor advance override (default = width+1; set 0 for non-advancing glyphs)" },
        "image":   { "$ref": "#/$defs/ImageSpec" }
      },
      "required": ["type", "image"]
    },

    "ApplyShortcodeNode": {
      "type": "object",
      "description": "Invokes a registered shortcode inline",
      "properties": {
        "type":      { "const": "emoji_deco:apply_shortcode" },
        "shortcode": { "type": "string", "description": "Shortcode name (without colons)" },
        "args":      { "type": "array", "items": { "$ref": "#/$defs/StringExpr" }, "description": "Positional arguments" }
      },
      "required": ["type", "shortcode"]
    },

    "ApplyDecoratorNode": {
      "type": "object",
      "description": "Invokes a registered decorator inline",
      "properties": {
        "type":      { "const": "emoji_deco:apply_decorator" },
        "decorator": { "type": "string", "description": "Decorator name (without #)" },
        "slot":      { "$ref": "#/$defs/RichNode", "description": "Content to wrap with the decorator" },
        "args":      { "type": "array", "items": { "$ref": "#/$defs/StringExpr" }, "description": "Positional arguments" }
      },
      "required": ["type", "decorator"]
    },

    "HoverTextNode": {
      "type": "object",
      "description": "Wraps contents with a hover tooltip",
      "properties": {
        "type":           { "const": "emoji_deco:hover/text" },
        "hover_contents": { "$ref": "#/$defs/RichNode", "description": "Text displayed on hover" },
        "contents":       { "$ref": "#/$defs/RichNode" }
      },
      "required": ["type", "contents"]
    },

    "StyleNode": {
      "type": "object",
      "description": "Applies Minecraft text formatting to contents",
      "properties": {
        "type":          { "const": "emoji_deco:style" },
        "color":         { "$ref": "#/$defs/StringExpr", "description": "Named color or #RRGGBB hex" },
        "bold":          { "$ref": "#/$defs/BoolExpr" },
        "italic":        { "$ref": "#/$defs/BoolExpr" },
        "underlined":    { "$ref": "#/$defs/BoolExpr" },
        "strikethrough": { "$ref": "#/$defs/BoolExpr" },
        "obfuscated":    { "$ref": "#/$defs/BoolExpr" },
        "font":          { "type": "string", "description": "Custom font resource location" },
        "contents":      { "$ref": "#/$defs/RichNode" }
      },
      "required": ["type", "contents"]
    },

    "McNamedColor": {
      "type": "string",
      "enum": [
        "black", "dark_blue", "dark_green", "dark_aqua", "dark_red",
        "dark_purple", "gold", "gray", "dark_gray", "blue",
        "green", "aqua", "red", "light_purple", "yellow", "white"
      ]
    },

    "McTextComponent": {
      "type": "object",
      "description": "Standard Minecraft text component (used without a 'type' field)",
      "properties": {
        "text":          { "type": "string" },
        "translate":     { "type": "string" },
        "with":          { "type": "array", "items": { "$ref": "#/$defs/RichNode" } },
        "color": {
          "anyOf": [
            { "$ref": "#/$defs/McNamedColor" },
            { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "description": "#RRGGBB hex color" },
            { "$ref": "#/$defs/ColorHsvNode" }
          ]
        },
        "bold":          { "$ref": "#/$defs/BoolExpr" },
        "italic":        { "$ref": "#/$defs/BoolExpr" },
        "underlined":    { "$ref": "#/$defs/BoolExpr" },
        "strikethrough": { "$ref": "#/$defs/BoolExpr" },
        "obfuscated":    { "$ref": "#/$defs/BoolExpr" },
        "font":          { "type": "string" },
        "extra":         { "type": "array", "items": { "$ref": "#/$defs/RichNode" } },
        "hoverEvent":    { "type": "object" },
        "clickEvent":    { "type": "object" }
      }
    },

    "RichNode": {
      "description": "A display node: string, array, MC text component, or any emoji_deco:* typed node",
      "anyOf": [
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/RichNode" } },
        { "$ref": "#/$defs/McTextComponent" },
        { "$ref": "#/$defs/SlotNode" },
        { "$ref": "#/$defs/GlowNode" },
        { "$ref": "#/$defs/ScaleNode" },
        { "$ref": "#/$defs/OffsetNode" },
        { "$ref": "#/$defs/RotateNode" },
        { "$ref": "#/$defs/ImageToGlyphNode" },
        { "$ref": "#/$defs/ApplyShortcodeNode" },
        { "$ref": "#/$defs/ApplyDecoratorNode" },
        { "$ref": "#/$defs/HoverTextNode" },
        { "$ref": "#/$defs/StyleNode" }
      ]
    },

    "Suggestions": {
      "description": "Autocomplete suggestions: static string array or dynamic provider",
      "anyOf": [
        { "type": "array", "items": { "type": "string" } },
        { "$ref": "#/$defs/PlayerNamesNode" }
      ]
    },

    "ArgSpec": {
      "type": "object",
      "description": "Defines one positional argument accepted by a shortcode or decorator",
      "properties": {
        "value_type":  { "type": "string", "enum": ["string", "boolean", "integer", "float"], "default": "string" },
        "default":     { "description": "Default value when the argument is omitted" },
        "label":       { "type": "string", "description": "Display label shown in autocomplete, e.g. '<color>'" },
        "suggestions": { "$ref": "#/$defs/Suggestions" },
        "hidden":      { "type": "boolean", "default": false, "description": "Hide this argument from the autocomplete UI" }
      }
    }

  }
}
